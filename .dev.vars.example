# Fictional demo data: 1 enables it; use 0 for your own event.
DEMO_MODE=0
# Keep demo admin/staff authentication enabled when DEMO_MODE=1.
DEMO_AUTH=1
# Standalone auth; sites is only safe behind a trusted Sites dispatch layer.
AUTH_MODE=basic
# Placeholder: set a long independent random admin password (username: admin).
ADMIN_PASSWORD=
# Placeholder: set a separate random staff password (username: admin).
STAFF_PASSWORD=
# Comma-separated admin identities; Basic auth uses the first address.
ADMIN_EMAILS=admin@example.test
# Placeholder: independent 32 random bytes encoded as Base64URL for legacy AES-GCM links.
INVITE_TOKEN_SECRET=
# Placeholder: independent 32 random bytes encoded as Base64URL for short links and seating cards.
INVITE_SHORT_TOKEN_SECRET=
# Lifetime of newly issued v3 invites in seconds (1 through 31536000).
INVITE_TOKEN_TTL_SECONDS=7776000
# Optional ISO UTC event-wide deadline for every invite format, including legacy links.
INVITE_TOKENS_EXPIRE_AT=
# Change this string to revoke all outstanding seating cards (default: 0).
SEATING_TOKEN_EPOCH=0
# Optional private HTTPS Make receiver URL for RSVP, opening and seating update events.
MAKE_WEBHOOK_URL=
# Optional private HTTPS Sheets read webhook returning valueRanges for configured tabs.
SEATING_SHEETS_WEBHOOK_URL=
# Placeholder: independent bearer secret for inbound WhatsApp RSVP requests.
WHATSAPP_RSVP_SECRET=
# Placeholder: independent bearer secret for service-triggered seating sync.
SEATING_SYNC_SECRET=
