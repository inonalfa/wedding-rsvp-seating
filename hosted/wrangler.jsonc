{
  "name": "wedding-rsvp-seating-hosted",
  "main": "worker.ts",
  "compatibility_date": "2026-10-20",
  "workers_dev": true,
  "preview_urls": false,
  "observability": { "enabled": false },
  "ratelimits": [
    { "name": "LOGIN_LIMIT", "namespace_id": "41001", "simple": { "limit": 10, "period": 60 } },
    { "name": "GUEST_LIMIT", "namespace_id": "41002", "simple": { "limit": 5, "period": 60 } },
    { "name": "CLIENT_LIMIT", "namespace_id": "41003", "simple": { "limit": 180, "period": 60 } }
  ],
  "triggers": { "crons": ["7 * * * *"] },
  "d1_databases": [
    {
      "binding": "HOSTED_DB",
      "database_name": "wedding-rsvp-seating-hosted",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ]
}
